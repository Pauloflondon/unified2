{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance Events Schema",
  "description": "Schema for audit events generated by Unified 2 governance layer",
  "type": "object",
  "required": ["event_type", "ts", "run_id", "actor", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "intent_captured",
        "policy_checked",
        "risk_assessed",
        "hitl_triggered",
        "review_decision"
      ],
      "description": "Type of governance event"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of event"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the run"
    },
    "actor": {
      "type": "string",
      "description": "Actor who triggered the event (system, admin, operator, auditor)"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific payload",
      "oneOf": [
        {
          "title": "Intent Captured",
          "properties": {
            "intent": {
              "type": "string",
              "description": "Description of the AI agent's intent"
            },
            "requested_tool": {
              "type": "string",
              "description": "Tool requested by the AI agent"
            }
          },
          "required": ["intent", "requested_tool"]
        },
        {
          "title": "Policy Checked",
          "properties": {
            "policy_name": {
              "type": "string",
              "description": "Name of the policy applied"
            },
            "policy_version": {
              "type": "string",
              "description": "Version of the policy applied"
            },
            "decision": {
              "type": "string",
              "enum": ["allow", "deny", "needs_review"],
              "description": "Policy decision"
            },
            "reason": {
              "type": "string",
              "description": "Reason for the policy decision"
            }
          },
          "required": ["policy_name", "policy_version", "decision"]
        },
        {
          "title": "Risk Assessed",
          "properties": {
            "risk_level": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
              "description": "Risk level assigned"
            },
            "pii_detected": {
              "type": "boolean",
              "description": "Whether PII was detected"
            },
            "pii_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Types of PII detected (email, phone, ssn, etc.)"
            },
            "reason": {
              "type": "string",
              "description": "Reason for the risk assessment"
            }
          },
          "required": ["risk_level", "pii_detected"]
        },
        {
          "title": "HITL Triggered",
          "properties": {
            "reason": {
              "type": "string",
              "description": "Reason for triggering human review"
            },
            "triggered_by": {
              "type": "string",
              "enum": ["policy", "risk", "manual"],
              "description": "What triggered HITL"
            }
          },
          "required": ["reason", "triggered_by"]
        },
        {
          "title": "Review Decision",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["approve", "reject", "override"],
              "description": "Admin decision"
            },
            "comment": {
              "type": "string",
              "description": "Admin comment (mandatory)"
            },
            "reviewer": {
              "type": "string",
              "description": "Admin who made the decision"
            }
          },
          "required": ["action", "comment", "reviewer"]
        }
      ]
    },
    "checksum": {
      "type": "string",
      "description": "SHA256 checksum of the event payload (for tamper detection)"
    }
  }
}
