{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Bundle Schema",
  "description": "Schema for audit evidence export (ZIP contents)",
  "type": "object",
  "required": ["manifest", "audit_events", "run_record", "redacted_payload"],
  "properties": {
    "manifest": {
      "type": "object",
      "description": "Metadata and checksums for audit bundle",
      "required": ["run_id", "exported_at", "exported_by", "checksums"],
      "properties": {
        "run_id": {
          "type": "string",
          "description": "Unique identifier for the run"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of export"
        },
        "exported_by": {
          "type": "string",
          "description": "Auditor who exported the bundle"
        },
        "checksums": {
          "type": "object",
          "description": "SHA256 checksums for each file in the bundle",
          "properties": {
            "audit_events": {
              "type": "string",
              "description": "SHA256 checksum of audit/audit.jsonl"
            },
            "run_record": {
              "type": "string",
              "description": "SHA256 checksum of run/run_record.json"
            },
            "redacted_payload": {
              "type": "string",
              "description": "SHA256 checksum of run/redacted_payload.json"
            }
          },
          "required": ["audit_events", "run_record", "redacted_payload"]
        }
      }
    },
    "audit_events": {
      "type": "array",
      "description": "Filtered audit events for this run",
      "items": {
        "$ref": "governance_events.json"
      }
    },
    "run_record": {
      "type": "object",
      "description": "Full run record (status, timestamps, decisions)",
      "$ref": "decision_status.schema.json"
    },
    "redacted_payload": {
      "type": "object",
      "description": "Original payload with PII redacted",
      "properties": {
        "intent": {
          "type": "string",
          "description": "Description of the AI agent's intent"
        },
        "payload": {
          "type": "object",
          "description": "Redacted payload (PII replaced with [REDACTED])"
        },
        "redacted_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of keys that were redacted (name, email, phone, etc.)"
        }
      },
      "required": ["intent", "payload", "redacted_keys"]
    }
  }
}
