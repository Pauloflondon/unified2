{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Status Schema",
  "description": "Schema for run status returned by Unified 2 API",
  "type": "object",
  "required": ["run_id", "status", "created_at", "updated_at"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the run"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "needs_review", "approved", "rejected", "blocked", "error"],
      "description": "Current status of the run"
    },
    "intent": {
      "type": "string",
      "description": "Description of the AI agent's intent"
    },
    "requested_tool": {
      "type": "string",
      "description": "Tool requested by the AI agent"
    },
    "policy_decision": {
      "type": "string",
      "enum": ["allow", "deny", "needs_review"],
      "description": "Policy evaluation result"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Risk level assigned"
    },
    "pii_detected": {
      "type": "boolean",
      "description": "Whether PII was detected"
    },
    "hitl_reason": {
      "type": "string",
      "description": "Reason for requiring human review (if applicable)"
    },
    "review_decision": {
      "type": "object",
      "description": "Admin review decision (if applicable)",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["approve", "reject", "override"],
          "description": "Admin decision"
        },
        "comment": {
          "type": "string",
          "description": "Admin comment"
        },
        "reviewer": {
          "type": "string",
          "description": "Admin who made the decision"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of review"
        }
      },
      "required": ["action", "comment", "reviewer", "reviewed_at"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run was last updated"
    }
  }
}
